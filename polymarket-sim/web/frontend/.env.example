# =============================================================================
# POLYMARKET SIMULATION TRADER - Frontend Environment Variables
# =============================================================================
# Copy this file to .env.local for local development
# For Railway deployment, set these in the Railway dashboard Environment tab
# =============================================================================

# =============================================================================
# BACKEND API URL (Required for real trading)
# =============================================================================
# Point to your deployed backend Railway service
# Leave empty or comment out to use Next.js API routes (mock data)
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app

# =============================================================================
# SUPABASE CONFIGURATION (Required for authentication)
# =============================================================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# These should match the backend Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# DEPLOYMENT MODE
# =============================================================================
# Options:
#   - "mock" = Use Next.js API routes with fake data (no backend needed)
#   - "real" = Use real backend with Polymarket API (requires NEXT_PUBLIC_API_URL)
NEXT_PUBLIC_MODE=real

# =============================================================================
# DEVELOPMENT OVERRIDES (Local development only)
# =============================================================================
# Uncomment for local development with local backend
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_MODE=real
