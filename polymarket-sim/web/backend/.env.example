# =============================================================================
# POLYMARKET SIMULATION TRADER - Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# For Railway deployment, set these in the Railway dashboard Environment tab
# =============================================================================

# =============================================================================
# SUPABASE CONFIGURATION (Required)
# =============================================================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# =============================================================================
# DATABASE CONFIGURATION (Required)
# =============================================================================
# Get from Supabase: https://supabase.com/dashboard/project/_/settings/database
# Format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@[HOST]:[PORT]/postgres
DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.your-project.supabase.co:5432/postgres

# =============================================================================
# JWT AUTHENTICATION (Required)
# =============================================================================
# Generate a secure secret key:
#   openssl rand -hex 32
JWT_SECRET_KEY=generate-a-secure-random-key-here-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=production
# Set to your deployed frontend URL (Railway will provide this)
FRONTEND_URL=https://your-frontend.up.railway.app
# Starting balance for new users (in USDC)
DEFAULT_STARTING_BALANCE=1000.0

# =============================================================================
# POLYMARKET API SETTINGS (Optional - uses defaults if not set)
# =============================================================================
# These are public Polymarket API endpoints (no auth required)
POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# =============================================================================
# LLM API KEYS (Optional - only needed for LLM Directional strategy)
# =============================================================================
# OpenAI API Key (for GPT-4, GPT-3.5)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (for Claude models)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# =============================================================================
# NEWS API KEYS (Optional - only needed for LLM Directional strategy)
# =============================================================================
# Twitter/X API (for real-time news)
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# Perplexity API (for research queries)
PERPLEXITY_API_KEY=pplx-your-perplexity-api-key

# =============================================================================
# RAILWAY-SPECIFIC (Auto-provided by Railway)
# =============================================================================
# These are automatically set by Railway - DO NOT SET MANUALLY
# PORT=8000
# RAILWAY_ENVIRONMENT=production
# RAILWAY_SERVICE_NAME=your-service-name

# =============================================================================
# DEVELOPMENT OVERRIDES (Local development only)
# =============================================================================
# Uncomment for local development
# ENVIRONMENT=development
# FRONTEND_URL=http://localhost:3000
# DATABASE_URL=sqlite+aiosqlite:///./dev.db
